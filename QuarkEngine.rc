#include <windows.h>

#define QUARK_VERSION_MAJOR 1
#define QUARK_VERSION_MINOR 0
#define QUARK_VERSION_PATCH 0
#define QUARK_VERSION_BUILD 0

#define QUARK_VERSION_STRING "1.0.0.0"
#define QUARK_PRODUCT_NAME "Quark Engine"
#define QUARK_COMPANY_NAME "Quark Engine Development Team"
#define QUARK_COPYRIGHT "Copyright (C) 2026 Quark Engine Development Team"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION QUARK_VERSION_MAJOR,QUARK_VERSION_MINOR,QUARK_VERSION_PATCH,QUARK_VERSION_BUILD
 PRODUCTVERSION QUARK_VERSION_MAJOR,QUARK_VERSION_MINOR,QUARK_VERSION_PATCH,QUARK_VERSION_BUILD
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", QUARK_COMPANY_NAME "\0"
            VALUE "FileDescription", "Quark Engine editor\0"
            VALUE "FileVersion", QUARK_VERSION_STRING "\0"
            VALUE "InternalName", "QuarkEngine.exe\0"
            VALUE "LegalCopyright", QUARK_COPYRIGHT "\0"
            VALUE "OriginalFilename", "QuarkEngine.exe\0"
            VALUE "ProductName", QUARK_PRODUCT_NAME "\0"
            VALUE "ProductVersion", QUARK_VERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
